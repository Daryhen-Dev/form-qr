// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Soft-delete convention: soft-deletable models add a deletedAt DateTime? field.
// Repositories MUST filter where deletedAt IS NULL by default.
// Hard-delete MUST NOT be exported for soft-deletable models.
// To delete: set deletedAt to the current UTC timestamp.

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  performedAt DateTime @default(now()) // UTC - stored as timestamptz
  metadata    Json?
}

// Role enum — mirrors the ROLE const in lib/types/index.ts (kept in sync manually).
enum Role {
  Administrador
  Secretario
  Empleado
}

model User {
  id                     String         @id @default(cuid())
  nombres                String
  apellidos              String
  cedula                 String         @unique
  passwordHash           String
  passwordChangeRequired Boolean        @default(true)
  role                   Role
  createdAt              DateTime       @default(now()) // UTC timestamptz
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime? // soft-delete; null = active
  refreshTokens      RefreshToken[]
  branchAssignments  BranchAssignment[] // relation field only — no column change

  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 of raw refresh JWT — never store raw
  expiresAt DateTime // UTC
  revokedAt DateTime? // set on logout or rotation
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Branches + Employee Assignment (Slice 3)
// ---------------------------------------------------------------------------

model Branch {
  id          String             @id @default(cuid())
  name        String
  code        String? // optional short code (nullable, additive)
  address     String?
  createdAt   DateTime           @default(now()) // UTC timestamptz
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime? // soft-delete; null = active
  assignments BranchAssignment[]

  @@index([deletedAt])
}

/// Partial unique index (single active assignment per employee) is added via raw SQL
/// in the migration; Prisma 7 cannot declare conditional unique indexes:
///   CREATE UNIQUE INDEX "uniq_active_assignment_per_user"
///     ON "BranchAssignment"("userId") WHERE "unassignedAt" IS NULL;
/// IMPORTANT: If this migration is ever regenerated (schema revert + re-create),
/// the raw SQL block above MUST be manually re-appended to the new migration.sql file.
model BranchAssignment {
  id           String    @id @default(cuid())
  branchId     String
  userId       String
  assignedAt   DateTime  @default(now()) // UTC
  unassignedAt DateTime? // null = active; set = closed (UTC)
  createdAt    DateTime  @default(now())
  branch       Branch    @relation(fields: [branchId], references: [id])
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([branchId])
}
