// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Soft-delete convention: soft-deletable models add a deletedAt DateTime? field.
// Repositories MUST filter where deletedAt IS NULL by default.
// Hard-delete MUST NOT be exported for soft-deletable models.
// To delete: set deletedAt to the current UTC timestamp.

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  performedAt DateTime @default(now()) // UTC - stored as timestamptz
  metadata    Json?
}

// Role enum — mirrors the ROLE const in lib/types/index.ts (kept in sync manually).
enum Role {
  Administrador
  Secretario
  Empleado
}

model User {
  id                     String         @id @default(cuid())
  nombres                String
  apellidos              String
  cedula                 String         @unique
  passwordHash           String
  passwordChangeRequired Boolean        @default(true)
  role                   Role
  createdAt              DateTime       @default(now()) // UTC timestamptz
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime? // soft-delete; null = active
  refreshTokens      RefreshToken[]
  branchAssignments  BranchAssignment[] // relation field only — no column change

  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 of raw refresh JWT — never store raw
  expiresAt DateTime // UTC
  revokedAt DateTime? // set on logout or rotation
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Branches + Employee Assignment (Slice 3)
// ---------------------------------------------------------------------------

model Branch {
  id          String             @id @default(cuid())
  name        String
  code        String? // optional short code (nullable, additive)
  address     String?
  createdAt   DateTime           @default(now()) // UTC timestamptz
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime? // soft-delete; null = active
  assignments BranchAssignment[]
  questionnaires QuestionnaireBranch[] // virtual relation only — no column change

  @@index([deletedAt])
}


/// Partial unique index (single active assignment per employee) is added via raw SQL
/// in the migration; Prisma 7 cannot declare conditional unique indexes:
///   CREATE UNIQUE INDEX "uniq_active_assignment_per_user"
///     ON "BranchAssignment"("userId") WHERE "unassignedAt" IS NULL;
/// IMPORTANT: If this migration is ever regenerated (schema revert + re-create),
/// the raw SQL block above MUST be manually re-appended to the new migration.sql file.
model BranchAssignment {
  id           String    @id @default(cuid())
  branchId     String
  userId       String
  assignedAt   DateTime  @default(now()) // UTC
  unassignedAt DateTime? // null = active; set = closed (UTC)
  createdAt    DateTime  @default(now())
  branch       Branch    @relation(fields: [branchId], references: [id])
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Questionnaire Templates + Versioning (Slice 4)
// ---------------------------------------------------------------------------

enum QuestionType {
  boolean
  single_choice
  multiple_choice
  scale
  short_text
  long_text
  number
  date
  time
  photo
  file
}

enum VersionStatus {
  draft
  published
}

model Questionnaire {
  id               String    @id @default(cuid())
  title            String
  description      String?
  currentVersionId String?   @unique // explicit published pointer (Decision 4)
  createdAt        DateTime  @default(now()) // UTC
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // soft-delete; null = active
  versions         QuestionnaireVersion[] @relation("QuestionnaireVersions")
  currentVersion   QuestionnaireVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  branches         QuestionnaireBranch[]

  @@index([deletedAt])
}

model QuestionnaireVersion {
  id              String        @id @default(cuid())
  questionnaireId String
  versionNumber   Int
  status          VersionStatus @default(draft)
  publishedAt     DateTime?                      // set on publish (UTC)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questionnaire   Questionnaire @relation("QuestionnaireVersions", fields: [questionnaireId], references: [id])
  currentOf       Questionnaire? @relation("CurrentVersion")
  questions       Question[]

  @@unique([questionnaireId, versionNumber])
  @@index([questionnaireId])
}

model Question {
  id        String       @id @default(cuid())
  versionId String
  order     Int                               // positive; unique within version
  type      QuestionType
  prompt    String
  required  Boolean      @default(false)
  config    Json                              // type-specific; validated by discriminated Zod union
  version   QuestionnaireVersion @relation(fields: [versionId], references: [id])

  @@unique([versionId, order])
  @@index([versionId])
}

model QuestionnaireBranch {
  id              String   @id @default(cuid())
  questionnaireId String
  branchId        String
  assignedAt      DateTime @default(now()) // UTC
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])
  branch          Branch        @relation(fields: [branchId], references: [id])

  @@unique([questionnaireId, branchId]) // Decision 7 — 409 backstop
  @@index([branchId])
}
