# Database for development
DATABASE_URL=postgresql://formqr:formqr@localhost:5433/form_qr

# Database for integration tests
TEST_DATABASE_URL=postgresql://formqr:formqr@localhost:5433/form_qr_test

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_hex_64_bytes
JWT_REFRESH_SECRET=replace_with_different_random_hex_64_bytes

# JWT TTLs in seconds
# ACCESS_TTL=900     → 15 minutes
# REFRESH_TTL=604800 → 7 days
ACCESS_TTL=900
REFRESH_TTL=604800

# Seed: cédula of the first Administrador user created by pnpm db:seed
SEED_ADMIN_CEDULA=12345678

# Base URL for QR scan links — used by qr.service to build scanUrl
APP_URL=http://localhost:3000

# Object storage (S3-compatible)
# STORAGE_PROVIDER: minio | s3 | r2
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=form-qr
# Generate secure keys for production:
STORAGE_ACCESS_KEY=replace_with_minio_or_s3_access_key
STORAGE_SECRET_KEY=replace_with_minio_or_s3_secret_key
# Public URL for serving stored objects (bucket must be public or use signed URLs)
STORAGE_PUBLIC_URL=http://localhost:9000/form-qr
