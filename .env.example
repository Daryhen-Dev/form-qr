# Database for local development
DATABASE_URL=postgresql://formqr:formqr@localhost:5433/form_qr

# Database for integration tests
TEST_DATABASE_URL=postgresql://formqr:formqr@localhost:5433/form_qr_test

# JWT secrets — replace both values with independently generated secrets
JWT_ACCESS_SECRET=replace_with_random_hex_64_bytes
JWT_REFRESH_SECRET=replace_with_different_random_hex_64_bytes

# JWT TTLs in seconds
ACCESS_TTL=900
REFRESH_TTL=604800

# Seed bootstrap. The admin is optional; its initial password equals its cedula and must be changed immediately.
SEED_ADMIN_CEDULA=12345678
# Demo users are opt-in for local development only. Leave false by default.
SEED_DEMO_USERS=false
SEED_SECRETARY_CEDULA=12345679
SEED_EMPLOYEE_CEDULA=12345670

# Base URL used to build QR scan links
APP_URL=http://localhost:3000

# Object storage (S3-compatible). These values match docker-compose MinIO.
# Development-only credentials: replace them outside local development.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=form-qr
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/form-qr
